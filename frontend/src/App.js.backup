import React, { useState } from 'react';
import { BrowserRouter as Router, Routes, Route, Link, useNavigate } from 'react-router-dom';
import { AuthProvider, useAuth } from './contexts/AuthContext';
import ProtectedRoute from './components/ProtectedRoute';
import Login from './pages/Login';
import './App.css';

// Import pages
import Dashboard from './pages/Dashboard';
import Scans from './pages/Scans';
import Findings from './pages/Findings';
import Frameworks from './pages/Frameworks';
import Trends from './pages/Trends';
import RecurringFindings from './pages/RecurringFindings';

// Main App Layout (with sidebar)
function AppLayout() {
  const [sidebarOpen, setSidebarOpen] = useState(true);
  const { user, logout } = useAuth();
  const navigate = useNavigate();

  const handleLogout = () => {
    logout();
    navigate('/login');
  };

  return (
    <div className="app">
      {/* Sidebar */}
      <aside className={`sidebar ${sidebarOpen ? 'open' : 'closed'}`}>
        <div className="sidebar-header">
          <h2>CSPM Dashboard</h2>
          <button
            className="toggle-btn"
            onClick={() => setSidebarOpen(!sidebarOpen)}
          >
            {sidebarOpen ? '◀' : '▶'}
          </button>
        </div>
        
        <nav className="sidebar-nav">
          <Link to="/" className="nav-item">
            <span className="icon">📊</span>
            {sidebarOpen && <span>Dashboard</span>}
          </Link>
          <Link to="/scans" className="nav-item">
            <span className="icon">🔍</span>
            {sidebarOpen && <span>Scans</span>}
          </Link>
          <Link to="/findings" className="nav-item">
            <span className="icon">📋</span>
            {sidebarOpen && <span>Findings</span>}
          </Link>
          <Link to="/recurring" className="nav-item">
            <span className="icon">🔁</span>
            {sidebarOpen && <span>Recurring</span>}
          </Link>
          <Link to="/frameworks" className="nav-item">
            <span className="icon">📚</span>
            {sidebarOpen && <span>Frameworks</span>}
          </Link>
          <Link to="/trends" className="nav-item">
            <span className="icon">📈</span>
            {sidebarOpen && <span>Trends</span>}
          </Link>
        </nav>

        {/* User info and logout at bottom of sidebar */}
        <div className="sidebar-footer">
          {sidebarOpen && (
            <>
              <div className="user-info">
                <div className="user-avatar">
                  {user?.username?.charAt(0).toUpperCase() || 'U'}
                </div>
                <div className="user-details">
                  <div className="user-name">{user?.username}</div>
                  <div className="user-role">{user?.role}</div>
                </div>
              </div>
              <button className="logout-btn" onClick={handleLogout}>
                🚪 Logout
              </button>
            </>
          )}
          {!sidebarOpen && (
            <button 
              className="logout-btn-icon" 
              onClick={handleLogout}
              title="Logout"
            >
              🚪
            </button>
          )}
        </div>
      </aside>

      {/* Main Content */}
      <main className="main-content">
        <Routes>
          <Route path="/" element={<Dashboard />} />
          <Route path="/scans" element={<Scans />} />
          <Route path="/findings" element={<Findings />} />
          <Route path="/frameworks" element={<Frameworks />} />
          <Route path="/trends" element={<Trends />} />
          <Route path="/recurring" element={<RecurringFindings />} />
        </Routes>
      </main>
    </div>
  );
}

// Main App Component
function App() {
  return (
    <AuthProvider>
      <Router>
        <Routes>
          {/* Public route - Login */}
          <Route path="/login" element={<Login />} />

          {/* Protected routes - All app pages */}
          <Route
            path="/*"
            element={
              <ProtectedRoute>
                <AppLayout />
              </ProtectedRoute>
            }
          />
        </Routes>
      </Router>
    </AuthProvider>
  );
}

export default App;
